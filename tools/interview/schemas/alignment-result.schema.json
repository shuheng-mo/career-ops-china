{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alignment-result",
  "title": "question→block 对齐 agent 回填（spec §5.1）",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "status", "matched_block_ids", "evidence_refs"],
        "properties": {
          "question_id": { "type": "string", "pattern": "^q\\d{3}$", "maxLength": 8 },
          "status": { "enum": ["matched", "ambiguous", "unmatched", "non_question", "pending"] },
          "matched_block_ids": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 192 } },
          "evidence_refs": { "type": "array", "maxItems": 50, "items": { "type": "string", "pattern": "^u\\d{3}$" } },
          "reasoning_summary": { "type": ["string", "null"], "maxLength": 500 }
        }
      }
    }
  }
}
