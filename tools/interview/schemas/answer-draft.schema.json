{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "answer-draft",
  "title": "agent 生成的答案草稿数组（approve 输入，spec §4.2.1 Draft/Approve）",
  "type": "array",
  "minItems": 1,
  "maxItems": 50,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["seed_id", "block_id", "claim_kind", "markdown", "questions", "fact_refs"],
    "properties": {
      "seed_id": { "type": "string", "pattern": "^[a-f0-9]{12}$" },
      "block_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}\\.[a-z0-9][a-z0-9._-]{0,127}$" },
      "claim_kind": { "enum": ["experience", "design", "knowledge"] },
      "markdown": { "type": "string", "minLength": 1, "maxLength": 20000 },
      "anchors": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 64 } },
      "questions": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "maxLength": 500 } },
      "rubric": {
        "type": ["object", "null"],
        "additionalProperties": false,
        "properties": {
          "required": { "type": "array", "maxItems": 20, "items": { "type": "object" } },
          "forbidden": { "type": "array", "maxItems": 20, "items": { "type": "object" } }
        }
      },
      "fact_refs": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 256 } }
    }
  }
}
