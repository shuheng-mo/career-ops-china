{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "segmentation-result",
  "title": "QA segmentation agent 回填（spec §5.1）",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "utterance_refs", "kind"],
        "properties": {
          "question_id": { "type": "string", "pattern": "^q\\d{3}$", "maxLength": 8 },
          "utterance_refs": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string", "pattern": "^u\\d{3}$" } },
          "kind": { "enum": ["question", "followup", "compound", "non_question"] },
          "notes": { "type": ["string", "null"], "maxLength": 500 }
        }
      }
    }
  }
}
